# General config of the OpenTagServer
[config]
haystack_endpoint = "http://100.100.100.100:6176"   # The endpoint of your Macless Haystack server
haystack_login = ""                                 # The login to use to connect to the Haystack server, leave empty if no authentication is required
haystack_password = ""                              # The password to use to connect to the Haystack, leave empty if no authentication is required
local_history = "True"                              # Whether to store a local history of the tags in our own database.
google_auto_query_interval_min = 60                 # The interval in minutes between automatic queries to Google to update the history. Set to 0 to disable, automatically disabled if local_history is False.
apple_auto_query_interval_min = 600                 # Same as above but for Apple, (Apple stores 7 days of history so can be much less frequent). Set to 0 to disable, automatically disabled if local_history is False.
google_key_refresh_interval_hours = 24              # How often (in hours) to re-upload Google announcement keys. Set to 0 to disable.
history_retention_days = 30                         # Maximum days of history kept. Devices can choose less in the UI. 0 = no maximum.
log_level = "INFO"                                  # Logging level for Docker console: DEBUG, INFO, WARNING, ERROR


# Apple: bulk updates plus with a per user sweep of singletons.
apple_manual_wait_timeout_seconds = 180     # Maximum manual operation wait; capped at 180 seconds.
google_refresh_settle_seconds = 15          # Wait after announcements refresh before automatic location queries.
apple_singleton_sweep_enabled = true
apple_singleton_sweep_interval_hours = 24   # Pause between completed passes; 0 keeps scanning continuously. Run/resume at container startup.
apple_singleton_interval_seconds = 60       # Minimum spacing per user; shared limiter may make this longer.
apple_request_interval_seconds = 60         # Shared across users/processes using this Haystack endpoint.
apple_error_backoff_seconds = 300           # Shared cooldown on HTTP/network errors; honors longer Retry-After.
apple_bulk_batch_size = 200     
apple_query_days = 7                        # Lookback for automatic bulk and singleton fetches.
# Set local_history=false to disable both automatic modes. Bulk interval 0 disables
# only bulk polling; apple_singleton_sweep_enabled=false disables only the sweep.

# Admin account. The admin only manages user accounts (in the web UI) and cannot see
# any keys, devices or locations. Generate the hash with: openssl passwd -6
[admin]
username = "admin"
password_hash = "$6$.mDwv..."
